
<%- include('../partials/header') %>
<%- include('../partials/navbar') %>

<main class="container">
  <h1>Daftar Menu</h1>

  <% if (pesan) { %>
    <p><%= pesan %></p>
  <% } %>

  <form action="/menu" method="GET">
    <input
      type="text"
      name="q"
      placeholder="Cari nama menu"
      value="<%= filter.q %>"
    >

    <select name="kategori">
      <option value="">Semua Kategori</option>
      <% kategoriList.forEach(function (kategori) { %>
        <option
          value="<%= kategori %>"
          <%= filter.kategori === kategori ? 'selected' : '' %>
        >
          <%= kategori %>
        </option>
      <% }) %>
    </select>

    <button type="submit">Cari</button>
    <a href="/menu">Reset</a>
  </form>

  <p>
    <a href="/menu/tambah">+ Tambah Menu Baru</a>
  </p>

  <% if (menus.length === 0) { %>
    <p>Belum ada menu. Klik Tambah Menu Baru untuk menambahkan menu.</p>
  <% } else { %>
    <table>
      <thead>
        <tr>
          <th>No</th>
          <th>Gambar</th>
          <th>Nama Menu</th>
          <th>Kategori</th>
          <th>Harga</th>
          <th>Stok</th>
          <th>Deskripsi</th>
          <th>Aksi</th>
        </tr>
      </thead>

      <tbody>
        <% menus.forEach(function (m, i) { %>
          <tr>
            <td><%= i + 1 %></td>

            <td>
              <% if (m.gambar) { %>
                <img
                src="/uploads/menu/<%= m.gambar %>"
                width="80"
                alt="Gambar menu"
                >
                <% } else { %>
                  -
                  <% } %>
                </td>

            <td><%= m.nama_menu %></td>
            <td><%= m.kategori %></td>
            <td><%= rupiah(m.harga) %></td>
            <td><%= m.stok %></td>
            <td><%= m.deskripsi || '-' %></td>

            <td>
              <a href="/menu/edit/<%= m.id %>">Edit</a>

              <form
                action="/menu/hapus/<%= m.id %>"
                method="POST"
                style="display:inline"
                onsubmit="return confirm('Yakin ingin menghapus menu ini?')"
              >
                <button type="submit">Hapus</button>
              </form>
            </td>
          </tr>
        <% }) %>
      </tbody>
    </table>
  <% } %>
</main>

<%- include('../partials/footer') %>
