<%- include('../partials/header') %>
<%- include('../partials/navbar') %>

<main class="container">
  <h1>Edit Paket</h1>

  <% if (errors.length > 0) { %>
    <ul>
      <% errors.forEach(function (e) { %>
        <li><%= e %></li>
      <% }) %>
    </ul>
  <% } %>

  <form action="/paket/<%= paket.id %>/edit" method="POST">
    <div>
      <label for="nama_paket">Nama paket</label>
      <input type="text" id="nama_paket" name="nama_paket" value="<%= paket.nama_paket || '' %>" required>
    </div>
    <div>
      <label for="harga">Harga (Rp)</label>
      <input type="number" id="harga" name="harga" min="1" value="<%= paket.harga || '' %>" required>
    </div>
    <div>
      <label for="deskripsi">Deskripsi</label>
      <textarea id="deskripsi" name="deskripsi" rows="3"><%= paket.deskripsi || '' %></textarea>
    </div>
    <button type="submit">Simpan Perubahan</button>
    <a href="/paket">Batal</a>
  </form>
</main>

<%- include('../partials/footer') %>