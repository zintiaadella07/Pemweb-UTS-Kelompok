<%- include('../partials/header', { title: title }) %>
<%- include('../partials/navbar') %>

<main class="container">
  <h1>Edit Menu</h1>

  <% if (errors.length > 0) { %>
    <ul class="alert">
      <% errors.forEach(function (e) { %><li><%= e %></li><% }) %>
    </ul>
  <% } %>

  <form action="/menu/edit/<%= menu.id %>" method="POST" enctype="multipart/form-data">
    <p>
      <label for="nama_menu">Nama menu</label><br>
      <input type="text" id="nama_menu" name="nama_menu" maxlength="100" required
             value="<%= menu.nama_menu || '' %>">
    </p>
    <p>
      <label for="kategori">Kategori</label><br>
      <select id="kategori" name="kategori" required>
        <% kategoriList.forEach(function (k) { %>
          <option value="<%= k %>" <%= menu.kategori === k ? 'selected' : '' %>><%= k %></option>
        <% }) %>
      </select>
    </p>
    <p>
      <label for="harga">Harga (Rp)</label><br>
      <input type="number" id="harga" name="harga" min="1" step="1" required
             value="<%= menu.harga ? Math.round(Number(menu.harga)) : '' %>">
    </p>
    <p>
      <label for="stok">Stok</label><br>
      <input type="number" id="stok" name="stok" min="0" step="1" required
             value="<%= menu.stok ?? 0 %>">
    </p>
    <p>
      <label for="deskripsi">Deskripsi</label><br>
      <textarea id="deskripsi" name="deskripsi" rows="3"><%= menu.deskripsi || '' %></textarea>
    </p>
    <p>
      <label for="gambar">Gambar (JPG atau PNG, maksimal 2 MB)</label><br>
      <% if (menu.gambar) { %>
        <img src="<%= /^https?:\/\//.test(menu.gambar) ? menu.gambar : '/uploads/menu/' + menu.gambar %>"
             alt="Gambar saat ini" style="width:160px;height:107px;object-fit:cover;border-radius:6px;display:block;margin:6px 0">
        <small>Gambar saat ini. Pilih file baru hanya jika ingin menggantinya.</small><br>
      <% } %>
      <input type="file" id="gambar" name="gambar" accept="image/png, image/jpeg">
    </p>
    <button type="submit">Perbarui</button>
    <a href="/menu">Batal</a>
  </form>
</main>

<%- include('../partials/footer') %>
