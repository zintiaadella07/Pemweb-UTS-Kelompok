<% if (errors && errors.length) { %>
  <div class="alert alert-error"><ul><% errors.forEach(e => { %><li><%= e %></li><% }) %></ul></div>
<% } %>

<% if (data.id_pemesanan) { %>
  <p><strong>Tanggal pemesanan:</strong> <%= formatTanggal(data.tanggal_pemesanan) %></p>
<% } else { %>
  <p><em>Tanggal pemesanan terisi otomatis dengan tanggal hari ini.</em></p>
<% } %>

<h3>Data Pemesanan</h3>
<div class="form-group">
  <label for="id_pelanggan">Pelanggan *</label>
  <select name="id_pelanggan" id="id_pelanggan" required>
    <option value="">-- Pilih pelanggan --</option>
    <% pelangganList.forEach(p => { %>
      <option value="<%= p.id_pelanggan %>" <%= String(data.id_pelanggan) === String(p.id_pelanggan) ? 'selected' : '' %>><%= p.nama_pelanggan %></option>
    <% }) %>
  </select>
</div>
<div class="form-group">
  <label for="id_paket">Paket *</label>
  <select name="id_paket" id="id_paket" required>
    <option value="">-- Pilih paket --</option>
    <% paketList.forEach(k => { %>
      <option value="<%= k.id_paket %>" data-harga="<%= k.harga_paket %>" <%= String(data.id_paket) === String(k.id_paket) ? 'selected' : '' %>><%= k.nama_paket %> - <%= formatRupiah(k.harga_paket) %></option>
    <% }) %>
  </select>
</div>
<div class="form-group">
  <label for="tanggal_acara">Tanggal acara *</label>
  <input type="date" name="tanggal_acara" id="tanggal_acara" value="<%= toInputDate(data.tanggal_acara) %>" <%- !data.id_pemesanan ? 'min="' + hariIni + '"' : '' %> required>
</div>
<div class="form-group">
  <label for="jumlah_paket">Jumlah paket *</label>
  <input type="number" name="jumlah_paket" id="jumlah_paket" min="1" step="1" value="<%= data.jumlah_paket || 1 %>" required>
</div>
<p>Estimasi total: <strong id="estimasi">-</strong> <small>(total final dihitung server)</small></p>

<h3>Pembayaran</h3>
<div class="form-group">
  <label for="status_pembayaran">Status pembayaran *</label>
  <select name="status_pembayaran" id="status_pembayaran">
    <% STATUS.forEach(s => { %><option value="<%= s %>" <%= data.status_pembayaran === s ? 'selected' : '' %>><%= s %></option><% }) %>
  </select>
</div>
<div class="form-group">
  <label for="metode_pembayaran">Metode pembayaran</label>
  <select name="metode_pembayaran" id="metode_pembayaran">
    <option value="">-- Pilih metode --</option>
    <% METODE.forEach(m => { %><option value="<%= m %>" <%= data.metode_pembayaran === m ? 'selected' : '' %>><%= m %></option><% }) %>
  </select>
</div>
<div class="form-group">
  <label for="tanggal_pembayaran">Tanggal pembayaran</label>
  <input type="date" name="tanggal_pembayaran" id="tanggal_pembayaran" value="<%= toInputDate(data.tanggal_pembayaran) %>">
  <small>Kosong + status lunas = otomatis hari ini.</small>
</div>
<div class="form-group">
  <label for="bukti_pembayaran">Bukti pembayaran (JPG, PNG, PDF, maks. 2 MB)</label>
  <input type="file" name="bukti_pembayaran" id="bukti_pembayaran" accept=".jpg,.jpeg,.png,.pdf">
  <% if (data.bukti_pembayaran) { %>
    <small>File saat ini: <a href="/uploads/bukti/<%= data.bukti_pembayaran %>" target="_blank">lihat</a>. Kosongkan jika tidak ingin mengganti.</small>
  <% } %>
</div>

<script>
  (function () {
    var paket = document.getElementById('id_paket');
    var jumlah = document.getElementById('jumlah_paket');
    var out = document.getElementById('estimasi');
    function hitung() {
      var opt = paket.options[paket.selectedIndex];
      var harga = opt ? Number(opt.getAttribute('data-harga')) : 0;
      var n = Number(jumlah.value);
      out.textContent = harga && n > 0 ? 'Rp ' + (harga * n).toLocaleString('id-ID') : '-';
    }
    paket.addEventListener('change', hitung);
    jumlah.addEventListener('input', hitung);
    hitung();
  })();
</script>