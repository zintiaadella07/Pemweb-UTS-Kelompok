
<%- include('../partials/header') %>
<%- include('../partials/navbar') %>

<main class="container">
  <h1>Edit Paket Katering</h1>

  <% if (errors.length > 0) { %>
    <ul>
      <% errors.forEach(error => { %>
        <li><%= error %></li>
      <% }) %>
    </ul>
  <% } %>

  <form
    action="/paket/edit/<%= data.id %>"
    method="POST"
    enctype="multipart/form-data"
  >

    <div>
      <label for="nama_paket">Nama Paket</label>
      <input
        type="text"
        id="nama_paket"
        name="nama_paket"
        value="<%= data.nama_paket || '' %>"
        required
      >
    </div>

    <div>
      <label for="deskripsi">Deskripsi</label>
      <textarea
        id="deskripsi"
        name="deskripsi"
        rows="3"
      ><%= data.deskripsi || '' %></textarea>
    </div>

    <div>
      <label for="harga">Harga (Rp)</label>
      <input
        type="number"
        id="harga"
        name="harga"
        value="<%= data.harga || '' %>"
        min="1"
        required
      >
    </div>

    <div>
      <label for="kapasitas">Kapasitas (orang)</label>
      <input
        type="number"
        id="kapasitas"
        name="kapasitas"
        value="<%= data.kapasitas || '' %>"
        min="1"
        required
      >
    </div>

    <div>
      <label for="tersedia">Ketersediaan</label>
      <select id="tersedia" name="tersedia">
        <option
          value="1"
          <%= Number(data.tersedia) === 1 ? 'selected' : '' %>
        >
          Tersedia
        </option>

        <option
          value="0"
          <%= Number(data.tersedia) === 0 ? 'selected' : '' %>
        >
          Tidak tersedia
        </option>
      </select>
    </div>

    <div>
      <label>Gambar Saat Ini</label>

      <% if (data.gambar) { %>
        <p>
          <img
            src="/uploads/paket/<%= data.gambar %>"
            width="120"
            alt="Gambar paket"
          >
        </p>
      <% } else { %>
        <p>Belum ada gambar.</p>
      <% } %>
    </div>

    <div>
      <label for="gambar">Ganti Gambar (opsional)</label>
      <input
        type="file"
        id="gambar"
        name="gambar"
        accept=".jpg,.jpeg,.png"
      >
    </div>

    <br>

    <button type="submit">Simpan Perubahan</button>
    <a href="/paket">Kembali</a>

  </form>
</main>

<%- include('../partials/footer') %>
